#!/bin/sh
# Toggle Dash to Dock between always-visible (fixed) and intelligent auto-hide.
# Bound to Cmd+Option+D (Ctrl+Alt+D after Toshy), like macOS.
D=org.gnome.shell.extensions.dash-to-dock
if [ "$(gsettings get $D dock-fixed)" = "true" ]; then
  gsettings set $D autohide true
  gsettings set $D intellihide true
  gsettings set $D dock-fixed false
else
  gsettings set $D dock-fixed true
fi
